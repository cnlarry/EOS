# 构建产物
bin/
obj/
bin-tmp/
obj-tmp/
dist/
coverage/
artifacts/
packages/

# 依赖目录
node_modules/

# 本地配置与密钥（不入库）
# 配置只在 appsettings.json 里写 ${VAR} 引用，真值放环境变量（见 docs/guide/02 第八节）。
# 下面两条是**防御性**规则：万一有人再建同名文件，也不会被提交。
.env
*.local
EOS.API/appsettings.Development.json
EOS.API/appsettings.Production.json

# 运行期产物
logs/
*.log
*.user
*.suo
*.cache
*.dbmdl
*.jfm

# 编辑器与工具本地状态
.vs/
.vscode/
.idea/

# 多 Agent 共享文件锁（本地协调状态，无提交价值）
.agents/reservations/

# 操作系统文件
.DS_Store
Thumbs.db
