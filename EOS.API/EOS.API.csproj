<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EOS.API</AssemblyName>
    <RootNamespace>EOS.API</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- EOS.API 仅部署 Windows（IIS / System.Drawing 字体与条码渲染）：抑制跨平台 CA1416 误报 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="dbup-sqlserver" Version="5.0.40" />
    <!-- 显式升级传递依赖：Microsoft.OpenApi 2.0.0 存在高危漏洞 GHSA-v5pm-xwqc-g5wc，2.7.5+ 已修复 -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 报表 PDF 中文字体（Noto Sans CJK SC，SIL OFL 1.1 许可） -->
    <None Include="Fonts\NotoSansCJKsc-Regular.otf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置版式格式包：开发态 Git 资产，部署复制到输出目录只读加载 -->
    <None Include="ReportFormats\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- EOS.ERP 版本化迁移脚本（唯一业务库，DbUp 启动时执行；对象名全大写） -->
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EOS.API.Tests" />
  </ItemGroup>

  <!-- 构建元数据：把 Git 提交与构建时间写进程序集，供 /health/version 报告。
       用途：区分「运行中的进程」与「磁盘上的二进制」是否同一份构建（排障/部署漂移）。
       无 .git（发布快照解包等）时跳过，端点会如实报告 unknown。 -->
  <Target Name="AddBuildMetadata" BeforeTargets="GetAssemblyAttributes"
          Condition="Exists('$(MSBuildProjectDirectory)\..\.git')">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitSha" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(GitCommitSha)" />
      <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))" />
    </ItemGroup>
  </Target>

</Project>
