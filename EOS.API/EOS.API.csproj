<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EOS.API</AssemblyName>
    <RootNamespace>EOS.API</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="dbup-sqlserver" Version="5.0.40" />
    <!-- 显式升级传递依赖：Microsoft.OpenApi 2.0.0 存在高危漏洞 GHSA-v5pm-xwqc-g5wc，2.7.5+ 已修复 -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 报表 PDF 中文字体（Noto Sans CJK SC，SIL OFL 1.1 许可） -->
    <None Include="Fonts\NotoSansCJKsc-Regular.otf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- EOS.IM 版本化迁移脚本：作为嵌入资源由 DbUp 在启动时执行 -->
    <EmbeddedResource Include="Data\Migrations\*.sql" />
    <!-- EOS.Mail 邮件任务库版本化迁移脚本（独立目录，与 IM 迁移互不干扰） -->
    <EmbeddedResource Include="Data\MailMigrations\*.sql" />
    <!-- EOS.ERP 版本化迁移脚本（唯一业务库，DbUp 启动时执行；对象名全大写） -->
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EOS.API.Tests" />
  </ItemGroup>

</Project>
