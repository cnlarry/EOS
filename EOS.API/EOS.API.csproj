<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EOS.API</AssemblyName>
    <RootNamespace>EOS.API</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 编译期护栏：本项目以"build 0 错 0 警"为口径，这里把它变成编译器强制。
         警告会直接失败构建，不再依赖人/Agent 自觉（nullable 解引用、未用变量、
         分析器规则等一律拦住）。确需豁免时用 NoWarn 并写明理由，不要整体关掉本项。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- EOS.API 仅部署 Windows（IIS / System.Drawing 字体与条码渲染）：抑制跨平台 CA1416 误报 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
    <!-- 显式升级传递依赖：Microsoft.OpenApi 2.0.0 存在高危漏洞 GHSA-v5pm-xwqc-g5wc，2.7.5+ 已修复 -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- 基本资料导入的 .xlsx 读取（Apache-2.0）：客户旧系统导出的表格多为 Excel，逐行解析留给它 -->
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 报表 PDF 中文字体（Noto Sans CJK SC，SIL OFL 1.1 许可） -->
    <None Include="Fonts\NotoSansCJKsc-Regular.otf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置版式格式包：开发态 Git 资产，部署复制到输出目录只读加载 -->
    <None Include="ReportFormats\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- EOS.ERP 版本化迁移脚本（唯一业务库，DbUp 启动时执行；对象名全大写） -->
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EOS.API.Tests" />
  </ItemGroup>

  <!-- 产品版本唯一真源：仓库根 version.json（前端 vite 配置、发布标签、CHANGELOG 同源）。
       在读取程序集属性前写入 Version/VersionPrefix，使 InformationalVersion 成为产品版本
       （SDK 仍会追加 +<sha>）。无 version.json 时保持 SDK 默认值，端点如实报告默认版本。
       解析方式：MSBuild 属性函数不能执行 System.Text.Json，故按行取出 "version" 那一行再剥离
       引号/冒号/逗号——version.json 只是「一个键」的极简文件，不需要完整 JSON 解析。 -->
  <Target Name="SetProductVersionFromVersionJson" BeforeTargets="GetAssemblyVersion;GetAssemblyAttributes"
          Condition="Exists('$(MSBuildProjectDirectory)\..\version.json')">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\..\version.json">
      <Output TaskParameter="Lines" ItemName="ProductVersionJsonLines" />
    </ReadLinesFromFile>
    <ItemGroup>
      <ProductVersionLine Include="@(ProductVersionJsonLines)"
                          Condition="$([System.String]::Copy('%(Identity)').Contains('version'))" />
    </ItemGroup>
    <PropertyGroup>
      <ProductVersionRaw>@(ProductVersionLine)</ProductVersionRaw>
      <Version>$([System.String]::Copy('$(ProductVersionRaw)').Replace('"version"','').Replace(':','').Replace('"','').Replace(',','').Trim())</Version>
      <VersionPrefix>$(Version)</VersionPrefix>
    </PropertyGroup>
  </Target>

  <!-- 构建元数据：把 Git 提交与构建时间写进程序集，供 /health/version 报告。
       用途：区分「运行中的进程」与「磁盘上的二进制」是否同一份构建（排障/部署漂移）。
       无 .git（发布快照解包等）时跳过，端点会如实报告 unknown。 -->
  <Target Name="AddBuildMetadata" BeforeTargets="GetAssemblyAttributes"
          Condition="Exists('$(MSBuildProjectDirectory)\..\.git')">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitSha" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(GitCommitSha)" />
      <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))" />
    </ItemGroup>
  </Target>

</Project>
