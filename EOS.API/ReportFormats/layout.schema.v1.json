{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/layout.schema.v1.json",
  "title": "EOS layout.json schema v1（可视化版式设计器）",
  "description": "layout.json 三重身份——存储格式 / 渲染契约 / 设计器文档模型。坐标单位 mm；fontSize 单位 pt。schemaVersion 版本化，变更需升版。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "page", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["document", "list"], "description": "document=单据型版式（固定字段与明细）；list=列表型版式（列由报表数据决定，用于报表清单打印）" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "orientation", "margin"],
      "properties": {
        "size": { "enum": ["A3", "A4", "A5", "LETTER", "LEGAL"] },
        "orientation": { "enum": ["portrait", "landscape", "auto"], "description": "auto=按内容列数决定（列表型版式：列多于 12 列自动横版）" },
        "margin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "content", "footer"],
      "properties": {
        "header": { "$ref": "#/$defs/section" },
        "content": { "$ref": "#/$defs/section" },
        "footer": { "$ref": "#/$defs/section" }
      }
    },
    "pageTemplates": {
      "type": "object",
      "additionalProperties": false,
      "description": "多页模板：第一页 / 续页 / 末页各自的页头页脚（缺省回退默认 sections）",
      "properties": {
        "first": { "$ref": "#/$defs/pageTemplate" },
        "continuation": { "$ref": "#/$defs/pageTemplate" },
        "last": { "$ref": "#/$defs/pageTemplate" }
      }
    }
  },
  "$defs": {
    "pageTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": { "$ref": "#/$defs/section" },
        "footer": { "$ref": "#/$defs/section" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elements"],
      "properties": {
        "height": { "type": "number", "minimum": 0, "description": "绝对定位模式下 header/footer 的固定区域高度（mm）；content 可省略；flow=true 时忽略" },
        "flow": {
          "type": "boolean",
          "default": false,
          "description": "按内容流动：同 y 的元素并成一行，行按 y 升序堆叠，无内容的整行略过，分区高度由内容决定。列表型报表的页头页脚用这个——固定高度会让空字段照样占位，页头一空就白留一块，同样的数据要多印纸。false（缺省）= 绝对定位，单据版式用"
        },
        "elements": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/element" }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "x", "y"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "type": { "enum": ["text", "field", "image", "line", "rect", "table", "barcode"] },
        "x": { "type": "number", "description": "相对所属 section 顶部的横坐标（mm）" },
        "y": { "type": "number", "description": "相对所属 section 顶部的纵坐标（mm）" },
        "w": { "type": "number", "minimum": 0, "description": "宽度（mm）；0 = 自适应" },
        "h": { "type": "number", "minimum": 0, "description": "高度（mm）；0 = 自适应" },
        "gap": { "type": "number", "minimum": 0, "description": "flow 模式下本行之前的间距（mm）；绝对定位模式忽略" },
        "hideWhenEmpty": { "type": "boolean", "description": "flow 模式下，content 里引用的任一 {{...}} 取值为空就整行略过。用于「标签：{{值}}」这类元素——标签是常量，光看渲染结果永远非空" },
        "visible": { "type": "boolean", "default": true },
        "content": { "type": "string", "description": "text：静态文本，支持 {{MASTER.X}} / {{SYS.X}} 占位符" },
        "field": { "type": "string", "description": "field：MASTER.* / SYS.*（表内列用 table.columns.field 引用 DETAILS.*）" },
        "format": { "type": ["string", "null"], "description": "DISPLAY_FORMAT 白名单格式（PdfLayout.FormatValue）" },
        "resourceId": { "type": "string", "description": "image：服务端白名单资源 ID（内置 SYS.LOGO）" },
        "barcodeType": { "enum": ["qrcode", "code128", "code39", "code93", "ean13", "upca", "upce", "itf", "codabar", "pdf417", "datamatrix", "aztec"], "description": "barcode：条码类型（白名单）" },
        "barcodeErrorCorrection": { "enum": ["L", "M", "Q", "H"], "description": "barcode：二维码纠错级别（L=7% / M=15% / Q=25% / H=30%）" },
        "barcodeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "barcode：前景色（hex）" },
        "barcodeBackground": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "barcode：背景色（hex）" },
        "barcodeLogo": { "type": "string", "description": "barcode：中心 Logo 资源 ID（服务端白名单，如 SYS.LOGO）" },
        "dataSource": { "enum": ["details", "master", "report"], "description": "table：details=明细行；master=主档字段名值对；report=报表清单行（列由报表数据决定，列表型版式专用）" },
        "columns": {
          "type": "array",
          "maxItems": 60,
          "items": { "$ref": "#/$defs/column" }
        },
        "showHeader": { "type": "boolean", "default": true },
        "repeatHeaderOnPageBreak": { "type": "boolean", "default": true },
        "showTotals": { "type": "boolean", "default": false, "description": "明细金额列逐列合计" },
        "totalsLabel": { "type": "string", "description": "价税合计行标签（跨列）" },
        "totalsField": { "type": "string", "description": "价税合计行取值字段（MASTER.*）" },
        "maxRows": { "type": "integer", "minimum": 1, "description": "master 数据源最多渲染行数（资料卡 Take(20)）" },
        "rowHeight": { "type": "number", "minimum": 0, "description": "table：明细行固定行高（mm），0 = 按内容自适应" },
        "title": { "type": "string", "description": "table 上方标题（资料卡'联系人'）" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "label"],
      "properties": {
        "field": { "type": "string", "description": "DETAILS.*（明细表）或 MASTER.*（master 数据源）" },
        "label": { "type": "string" },
        "width": { "type": ["number", "null"], "description": "列宽（mm）；null = 均分剩余宽度" },
        "align": { "enum": ["left", "center", "right"], "default": "left" },
        "format": { "type": ["string", "null"] },
        "suffix": { "type": ["string", "null"], "description": "非空值追加的后缀（如 '%'）" },
        "isAmount": { "type": "boolean", "description": "参与合计行求和" },
        "negativeRed": { "type": "boolean", "description": "负数显示为红色（金额条件格式）" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": { "type": "number", "minimum": 1, "maximum": 200, "description": "pt" },
        "bold": { "type": "boolean" },
        "semiBold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "align": { "enum": ["left", "center", "right"], "default": "left" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "borderColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "borderWidth": { "type": "number", "minimum": 0 },
        "padding": { "type": "number", "minimum": 0, "description": "pt" },
        "lineWidth": { "type": "number", "minimum": 0, "description": "line 线宽（pt）" },
        "striped": { "type": "boolean", "description": "table：明细行隔行底色" }
      }
    }
  }
}
