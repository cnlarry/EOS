{
  "ConnectionStrings": {
    "ErpDatabase": "${MSSQL_ERP_CONN}"
  },
  "EffectEngine": { "Enabled": true },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EOS.API": "Information"
    },
    "File": {
      "Path": "logs",
      "MaxBytes": 52428800,
      "MaxFiles": 30,
      "RetentionDays": 14
    }
  },
  "Audit": {
    "FieldChangesEnabled": true
  },
  "AssistantTranscript": {
    "Enabled": false,
    "Directory": "logs/assistant-transcripts",
    "MaxTurns": 100
  },
  "AssistantEngine": {
    "Kind": "legacy"
  },
  "Workflow": {
    "OverdueDays": 3
  },
  "AllowedHosts": "*",
  "NavigationIcons": {
    "11": "base",
    "12": "product",
    "13": "inventory",
    "14": "sales",
    "15": "production",
    "16": "procurement",
    "17": "finance",
    "18": "hr",
    "19": "vehicle",
    "20": "barcode",
    "21": "workflow",
    "22": "report",
    "23": "settings",
    "24": "sample",
    "25": "query",
    "26": "product",
    "27": "production",
    "28": "outsource",
    "29": "equipment",
    "30": "customs",
    "32": "finance",
    "33": "quality",
    "38": "hr",
    "39": "quality",
    "31": "robot"
  },
  "Security": {
    "PermissionCache": {
      "TtlSeconds": 60
    },
    "LoginThrottle": {
      "MaxFailures": 5,
      "Window": "00:10:00",
      "Lockout": "00:15:00"
    },
    "AllowedOrigins": [
      "http://localhost",
      "http://127.0.0.1",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5174",
      "http://localhost:5175",
      "http://www.erp.com"
    ]
  },
  "DataProtection": {
    "KeysDirectory": "${LOCALAPPDATA}\\EOS\\DataProtection-Keys",
    "ApplicationName": "EOS.API"
  },
  "Attachment": {
    "StorageRoot": "",
    "MaxSizeBytes": 52428800,
    "AllowedExtensions": ".pdf;.doc;.docx;.xls;.xlsx;.jpg;.jpeg;.png;.gif;.txt;.csv;.zip"
  },
  "ReportFormats": {
    "StorageRoot": ""
  }
}
